# Copy values into Vercel Project Settings > Environment Variables (Production).
# Examples only: never deploy with these placeholders.
GAS_API_URL=https://script.google.com/macros/s/REPLACE_WITH_YOUR_DEPLOYMENT_ID/exec
GAS_HMAC_SECRET=REPLACE_WITH_VIEWER_HMAC
GAS_DASHBOARD_HMAC_SECRET=REPLACE_WITH_DASHBOARD_HMAC
SESSION_SECRET=REPLACE_WITH_SESSION_SECRET
GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_YOUR_CLIENT_ID.apps.googleusercontent.com
VITE_GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_YOUR_CLIENT_ID.apps.googleusercontent.com

{
  "name": "mealform-ui-preview",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "dev": "npm run tokens && vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "npm run tokens && tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "storybook": "npm run tokens && storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "build-storybook": "npm run tokens && storybook build --disable-telemetry",
    "chromatic": "node scripts/chromatic.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "class-variance-authority": "0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "1.56.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@storybook/addon-designs": "11.1.4",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@tokens-studio/sd-transforms": "2.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "chromatic": "18.12.0",
    "storybook": "10.6.2",
    "style-dictionary": "5.6.1",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "vite": "8.3.0"
  }
}
